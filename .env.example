# -------------------------------------------------------------
# PLATAFORMA INTEGRADA GLESSIOS - VARIÁVEIS DE AMBIENTE
# -------------------------------------------------------------

# Banco de Dados (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glessios_db?schema=public"

# Cache e Filas (Redis 7)
REDIS_URL="redis://localhost:6379"

# Autenticação e Segurança
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="glessios_secret_super_seguro_development_2026_jwt_token"

# Blog Autônomo com IA (NVIDIA NIM API)
NVIDIA_API_KEY="nvapi-demo-placeholder"
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"

# Bancos de Imagens Gratuitos (Unsplash / Pexels)
UNSPLASH_ACCESS_KEY="unsplash-access-key-placeholder"
PEXELS_API_KEY="pexels-api-key-placeholder"

# WhatsApp Gateway (WACLI - WhatsApp CLI / Local Service)
WHATSAPP_PROVIDER="wacli"
WACLI_PATH="wacli"
WACLI_API_URL="http://localhost:3001"
WACLI_SESSION="glessios-wpp"

# Cron Job Runner Security Token
CRON_SECRET_TOKEN="cron-token-glessios-2026-auth"

# Gateway de Pagamentos (PIX / Boleto)
PAYMENT_GATEWAY_PROVIDER="asaas"
PAYMENT_GATEWAY_API_KEY="payment-gateway-placeholder"
