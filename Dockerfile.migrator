# -----------------------------------------------------------------------------
# Dockerfile Leve para Migrações Prisma e Seed — Glessios Comunicação Visual
# -----------------------------------------------------------------------------
FROM node:20-alpine

WORKDIR /app
RUN apk add --no-cache openssl libc6-compat

# Copia apenas o necessário para as migrações e seed
COPY prisma ./prisma/
COPY tsconfig.json* ./

# Inicializa um package.json limpo para isolamento total de dependências
# Evita ler lockfile com binários desnecessários como @next/swc
RUN npm init -y && \
    npm install prisma@6.19.3 @prisma/client@6.19.3 tsx@4.19.2 bcryptjs@2.4.3 @types/bcryptjs typescript@5.3.3 @types/node --no-audit --no-fund --no-package-lock && \
    npm cache clean --force

# Gera o Prisma Client
RUN npx prisma generate

CMD ["sh", "-c", "npx prisma db push && npx tsx prisma/seed.ts"]
