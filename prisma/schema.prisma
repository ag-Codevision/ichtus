datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ====================================================
// ENUMS DO SISTEMA GLESSIOS
// ====================================================

enum UserRole {
  ADMIN
  CUSTOMER
}

enum CustomerType {
  CUSTOMER          // Cliente (comprador de fachadas, luminosos, impressões)
  SERVICE_PROVIDER  // Prestador de Serviços (instaladores de campo, serralheiros, terceiros)
  SUPPLIER          // Fornecedor de Matéria-Prima e Insumos (chapas ACM, lonas, LEDs, tintas)
}

enum PersonType {
  PJ                // Pessoa Jurídica
  PF                // Pessoa Física
}

enum CustomerStatus {
  ACTIVE            // Ativo
  INACTIVE          // Inativo
  LEAD_PROSPECT     // Em Prospecção / Negociação
  BLOCKED           // Bloqueado
}

enum LeadSource {
  WEBSITE_FORM
  WHATSAPP
  MANUAL_ADMIN
  INSTAGRAM_FACEBOOK
  INDICATION
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OSStage {
  BRIEFING_ARTWORK
  ARTWORK_APPROVAL
  CNC_ROUTER_CUTTING
  DIGITAL_PRINTING
  ASSEMBLY_STRUCTURE
  QUALITY_CONTROL
  READY_FOR_INSTALLATION
  INSTALLED_COMPLETED
  CANCELLED
}

enum ArtworkStatus {
  PENDING_CUSTOMER_REVIEW
  APPROVED
  REVISION_REQUESTED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  PIX
  BOLETO
  CREDIT_CARD
  BANK_TRANSFER
  CASH
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
}

enum AppointmentType {
  TECHNICAL_VISIT_MEASUREMENT
  INTERNAL_PRODUCTION_RUN
  EXTERNAL_INSTALLATION
  DELIVERY_PICKUP
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum StockUnit {
  M2           // Metros quadrados (Lona, ACM, Vinil)
  LINEAR_METER // Metros lineares (Perfis, Fitas)
  UNIT         // Peças (LEDs, Fontes, Ilhoses)
  LITER        // Tintas e Vernizes
  SHEET        // Placas inteiras de ACM/Acrílico
  ROLL         // Rolos fechados
}

enum MovementType {
  INCOMING_PURCHASE
  OUTGOING_PRODUCTION_OS
  OUTGOING_LOSS_DEFECT
  MANUAL_ADJUSTMENT
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ====================================================
// USUÁRIOS E AUTENTICAÇÃO
// ====================================================

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  passwordHash    String
  phone           String?     // Formato: 5541999999999
  role            UserRole    @default(CUSTOMER)
  avatarUrl       String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customerProfile Customer?
  createdOS       ServiceOrder[] @relation("CreatedBy")
  assignedLeads   Lead[]
  notifications   Notification[]
  stockMovements  StockMovement[]

  @@map("users")
}

model Customer {
  id                    String                 @id @default(cuid())
  userId                String?                @unique
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  type                  CustomerType           @default(CUSTOMER)
  personType            PersonType             @default(PJ)
  status                CustomerStatus         @default(ACTIVE)

  // Identificação PJ / PF
  companyName           String?                // Razão Social
  tradeName             String?                // Nome Fantasia / Nome Comercial
  fullName              String?                // Nome Completo (se Pessoa Física)
  documentNumber        String?                // CPF ou CNPJ
  stateRegistration     String?                // Inscrição Estadual (IE)
  municipalRegistration String?                // Inscrição Municipal (IM)
  rg                    String?                // RG (para Pessoa Física)

  // Contato e Comunicação
  contactPerson         String?                // Nome do contato responsável
  contactRole           String?                // Cargo (ex: Diretor de Compras)
  contactPersonPhone    String?                // Telefone/WhatsApp direto do interlocutor
  contactPersonEmail    String?                // E-mail direto do interlocutor
  contactPersonNotes    String?                // Anotações da conversa / contexto da indicação
  leadChannel           String?                // Origem do Lead (INDICATION, GOOGLE, FACEBOOK, INSTAGRAM, WHATSAPP, OTHER)
  leadChannelDetails    String?                // Detalhes (ex: De quem é a indicação, feira)
  phone                 String?                // Telefone Fixo
  whatsapp              String?                // WhatsApp Comercial (5541999999999)
  email                 String?                // E-mail Geral
  financialEmail        String?                // E-mail Financeiro/NFe

  // Endereço Completo
  zipCode               String?                // CEP (00000-000)
  street                String?                // Logradouro / Rua / Avenida
  number                String?                // Número
  complement            String?                // Complemento (Sala, Galpão, Bloco)
  neighborhood          String?                // Bairro
  city                  String?                // Cidade
  state                 String?                // UF (PR, SP, etc.)
  referencePoint        String?                // Ponto de Referência para equipes de campo

  // Dados Comerciais e Financeiros (para pagamentos a prestadores/fornecedores e crédito de clientes)
  creditLimit           Decimal?               @db.Decimal(12, 2)
  paymentTerms          String?                // Ex: "50% entrada + 50% na instalação", "30 dias líquido"
  pixKeyType            String?                // "CPF", "CNPJ", "EMAIL", "PHONE", "RANDOM"
  pixKey                String?                // Chave PIX cadastrada
  bankName              String?                // Nome do Banco (ex: Nubank, Itaú, BB)
  bankAgency            String?                // Agência
  bankAccount           String?                // Conta Corrente / Poupança

  notes                 String?                @db.Text
  tags                  String[]               @default([])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  serviceOrders         ServiceOrder[]
  invoices              Invoice[]
  appointments          Appointment[]
  leads                 Lead[]
  assistedLeads         Lead[]                 @relation("LeadHelper")
  stockItems            StockItem[]
  financialTransactions FinancialTransaction[]
  documents             Document[]

  @@map("customers")
}

// ====================================================
// CRM KANBAN & LEADS COMERCIAIS
// ====================================================

model KanbanColumn {
  id        String       @id @default(cuid())
  name      String       // Ex: Novo Lead, Briefing, Proposta Enviada, Aprovado
  order     Int          // Ordenação visual no board
  color     String?      // Cor hexadecimal para visualização
  isSystem  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  leads     Lead[]

  @@map("kanban_columns")
}

model Lead {
  id              String        @id @default(cuid())
  budgetCode      String?       @unique // ID Sequencial Inteligente do Orçamento (ex: "3000 21 10 26")
  columnId        String
  column          KanbanColumn  @relation(fields: [columnId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  helperId        String?
  helper          Customer?     @relation("LeadHelper", fields: [helperId], references: [id])
  voltage         String?       // Voltagem do Local: "110V" ou "220V"
  tools           String[]      @default([]) // Ferramentas & Recursos Necessários
  paintDetails    String?       // Especificação de Tinta
  freightDetails  String?       // Detalhes de Frete
  proposalContent String?       @db.Text // Conteúdo dinâmico da Proposta
  contractContent String?       @db.Text // Minuta dinâmica do Contrato
  title           String        // Ex: "Fachada Loja Tech - Letreiro Luminoso"
  contactName     String
  contactPhone    String
  contactEmail    String?
  source          LeadSource    @default(WEBSITE_FORM)
  estimatedValue  Decimal?      @db.Decimal(12, 2)
  priority        PriorityLevel @default(MEDIUM)
  notes           String?       @db.Text
  dueDate         DateTime?     // Data limite / entrega
  reminderAt      DateTime?     // Lembrete agendado
  isCompleted     Boolean       @default(false)
  coverImage      String?       // URL da imagem de capa (estilo Trello)
  assignedToId    String?
  assignedTo      User?         @relation(fields: [assignedToId], references: [id])
  orderInColumn   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tags            LeadTagAssignment[]
  checklists      LeadChecklist[]
  attachments     LeadAttachment[]
  comments        LeadComment[]
  activities      LeadActivity[]
  serviceOrders   ServiceOrder[]
  documents       Document[]

  @@map("leads")
}

model KanbanTag {
  id        String              @id @default(cuid())
  name      String              // Ex: "Urgente", "Fachada ACM", "Letreiro LED"
  color     String              // Hexadecimal ex: "#EF4444"
  createdAt DateTime            @default(now())
  leads     LeadTagAssignment[]

  @@map("kanban_tags")
}

model LeadTagAssignment {
  id     String    @id @default(cuid())
  leadId String
  lead   Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId  String
  tag    KanbanTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
  @@map("lead_tag_assignments")
}

model LeadChecklist {
  id        String              @id @default(cuid())
  leadId    String
  lead      Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title     String              // Ex: "Briefing", "Medições e Vistoria"
  order     Int                 @default(0)
  items     LeadChecklistItem[]
  createdAt DateTime            @default(now())

  @@map("lead_checklists")
}

model LeadChecklistItem {
  id          String        @id @default(cuid())
  checklistId String
  checklist   LeadChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean       @default(false)
  order       Int           @default(0)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())

  @@map("lead_checklist_items")
}

model LeadAttachment {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fileName       String   // Nome do arquivo ou título do link
  fileUrl        String   // URL relativa (/uploads/...) ou externa
  fileType       String   // "IMAGE", "PDF", "DOCUMENT", "LINK"
  fileSize       Int?     // Em bytes
  isCover        Boolean  @default(false) // Se é capa do cartão
  isExternalLink Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("lead_attachments")
}

model LeadComment {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorName   String   // Nome de quem comentou
  authorAvatar String?
  content      String   @db.Text
  createdAt    DateTime @default(now())

  @@map("lead_comments")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // "CREATED", "STAGE_CHANGE", "FIELD_UPDATE", "CHECKLIST", "ATTACHMENT", "COMMENT"
  content   String   @db.Text
  userName  String?  // Nome de quem executou a ação
  createdAt DateTime @default(now())

  @@map("lead_activities")
}


// ====================================================
// ORDENS DE SERVIÇO & FLUXO DE PRODUÇÃO INDUSTRIAL
// ====================================================

model ServiceOrder {
  id               String         @id @default(cuid())
  code             String         @unique // Ex: "OS-2026-0001"
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id])
  leadId           String?
  lead             Lead?          @relation(fields: [leadId], references: [id])
  createdById      String
  createdBy        User           @relation("CreatedBy", fields: [createdById], references: [id])
  title            String
  description      String?        @db.Text
  currentStage     OSStage        @default(BRIEFING_ARTWORK)
  priority         PriorityLevel  @default(MEDIUM)
  deadline         DateTime?
  installationDate DateTime?
  totalAmount      Decimal        @db.Decimal(12, 2)
  discount         Decimal        @default(0.00) @db.Decimal(12, 2)
  netAmount        Decimal        @db.Decimal(12, 2)
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            ServiceOrderItem[]
  artworkProofs    ArtworkProof[]
  invoices         Invoice[]
  appointments     Appointment[]
  stockMovements   StockMovement[]
  documents        Document[]
  productionColumnId String?
  productionColumn ProductionColumn? @relation(fields: [productionColumnId], references: [id], onDelete: SetNull)

  @@map("service_orders")
}

model ServiceOrderItem {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  description    String       // Ex: "Letreiro Caixa Alta Acrílico com LED"
  unit           String       // "un", "m²", etc.
  quantity       Decimal      @db.Decimal(10, 2)
  widthMeters    Decimal?     @db.Decimal(10, 3)
  heightMeters   Decimal?     @db.Decimal(10, 3)
  unitPrice      Decimal      @db.Decimal(12, 2)
  totalPrice     Decimal      @db.Decimal(12, 2)

  @@map("service_order_items")
}

model ArtworkProof {
  id             String        @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  version        Int           @default(1)
  title          String        // Ex: "Layout Fachada Versão 1"
  fileUrl        String        // Link do PDF/Imagem no Storage
  previewUrl     String        // Thumbnail para o portal
  status         ArtworkStatus @default(PENDING_CUSTOMER_REVIEW)
  customerNotes  String?       @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@map("artwork_proofs")
}

// ====================================================
// ESTOQUE DE MATERIAIS DE COMUNICAÇÃO VISUAL
// ====================================================

model StockItem {
  id              String          @id @default(cuid())
  name            String          // Ex: "Chapa ACM 3mm Prata Brilho", "Lona 440g Fosca"
  sku             String          @unique
  category        String          // "Chapas", "Lonas", "Adesivos", "Ferragens", "LEDs"
  unit            StockUnit
  currentQuantity Decimal         @db.Decimal(12, 3)
  minQuantity     Decimal         @db.Decimal(12, 3) // Alerta de reposição
  averageUnitCost Decimal         @db.Decimal(12, 2)
  supplier        String?
  supplierId      String?
  supplierRel     Customer?       @relation(fields: [supplierId], references: [id])
  location        String?         // Galpão A, Prateleira 2
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  movements       StockMovement[]

  @@map("stock_items")
}

model StockMovement {
  id             String        @id @default(cuid())
  stockItemId    String
  stockItem      StockItem     @relation(fields: [stockItemId], references: [id])
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  type           MovementType
  quantity       Decimal       @db.Decimal(12, 3)
  unitCost       Decimal       @db.Decimal(12, 2)
  totalCost      Decimal       @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())

  @@map("stock_movements")
}

// ====================================================
// MÓDULO FINANCEIRO, FATURAS E FLUXO DE CAIXA
// ====================================================

model Invoice {
  id               String                 @id @default(cuid())
  code             String                 @unique // Ex: "FAT-2026-0042"
  serviceOrderId   String
  serviceOrder     ServiceOrder           @relation(fields: [serviceOrderId], references: [id])
  customerId       String
  customer         Customer               @relation(fields: [customerId], references: [id])
  amount           Decimal                @db.Decimal(12, 2)
  dueDate          DateTime
  paidDate         DateTime?
  status           InvoiceStatus          @default(PENDING)
  paymentMethod    PaymentMethod?
  pixQrCodeBase64  String?                @db.Text
  pixCopyPasteCode String?                @db.Text
  pdfUrl           String?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  transactions     FinancialTransaction[]

  @@map("invoices")
}

model FinancialTransaction {
  id          String                   @id @default(cuid())
  invoiceId   String?
  invoice     Invoice?                 @relation(fields: [invoiceId], references: [id])
  customerId  String?
  customer    Customer?                @relation(fields: [customerId], references: [id])
  type        FinancialTransactionType
  category    String                   // "Vendas", "Fornecedores", "Salários", "Energia"
  description String
  amount      Decimal                  @db.Decimal(12, 2)
  entryDate   DateTime                 @default(now())
  bankAccount String?                  // Conta bancária / Caixa
  receiptUrl  String?
  createdAt   DateTime                 @default(now())

  @@map("financial_transactions")
}

// ====================================================
// AGENDAMENTOS E CALENDÁRIO DE CAMPO
// ====================================================

model Appointment {
  id              String            @id @default(cuid())
  title           String            // Ex: "Instalação Fachada Luminosa"
  type            AppointmentType
  status          AppointmentStatus @default(SCHEDULED)
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  serviceOrderId  String?
  serviceOrder    ServiceOrder?     @relation(fields: [serviceOrderId], references: [id])
  scheduledAt     DateTime
  durationMinutes Int               @default(60)
  locationAddress String?
  assignedTeam    String?           // Equipe de instaladores
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("appointments")
}

// ====================================================
// PORTFÓLIO & BLOG AUTÔNOMO COM IA
// ====================================================

model PortfolioProject {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  category       String    // "Fachadas", "Envelopamento", "Luminosos", "Stands"
  clientName     String?
  description    String    @db.Text
  featuredImage  String
  galleryImages  String[]  // URLs adicionais
  tags           String[]
  isFeatured     Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("portfolio_projects")
}

model BlogPost {
  id                String     @id @default(cuid())
  title             String
  slug              String     @unique
  excerpt           String     @db.Text
  contentMarkdown   String     @db.Text
  coverImageUrl     String
  imageAlt          String
  imagePhotographer String?
  status            PostStatus @default(PUBLISHED)
  metaTitle         String
  metaDescription   String
  canonicalUrl      String?
  tags              String[]
  readingTimeMin    Int        @default(4)
  viewCount         Int        @default(0)
  publishedAt       DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("blog_posts")
}

// ====================================================
// NOTIFICAÇÕES MULTICANAL (IN-APP & WHATSAPP)
// ====================================================

model Notification {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  message         String    @db.Text
  linkUrl         String?
  isRead          Boolean   @default(false)
  sentViaWhatsapp Boolean   @default(false)
  whatsappStatus  String?   // "SENT", "DELIVERED", "FAILED"
  createdAt       DateTime  @default(now())

  @@map("notifications")
}


// ====================================================
// DOCUMENTOS COMERCIAIS & ORCAMENTOS
// ====================================================

model Document {
  id              String        @id @default(cuid())
  code            String?
  title           String
  category        String        @default("ORCAMENTO")
  fileUrl         String
  fileSize        Int?
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceOrderId  String?
  serviceOrder    ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  clientName      String
  clientPhone     String?
  clientEmail     String?
  totalAmount     Decimal?      @db.Decimal(12, 2)
  status          String        @default("GERADO")
  sentViaWhatsapp Boolean       @default(false)
  sentAt          DateTime?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("documents")
}

// ====================================================
// COLUNAS DINAMICAS DA LINHA DE PRODUCAO (CRUD)
// ====================================================

model ProductionColumn {
  id            String         @id @default(cuid())
  name          String
  order         Int
  color         String?
  stageKey      String?
  isSystem      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  serviceOrders ServiceOrder[]

  @@map("production_columns")
}
